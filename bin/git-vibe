#!/usr/bin/env bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="$(cd "${SELF_DIR}/.." && pwd)"
VERSION_FILE="${APP_ROOT}/VERSION"
VERSION="0.0.0"

if [[ -f "${VERSION_FILE}" ]]; then
  VERSION="$(<"${VERSION_FILE}")"
fi

die() {
  printf 'git-vibe: %s\n' "$*" >&2
  exit 1
}

say() {
  printf '%s\n' "$*"
}

say_shell_chdir() {
  printf '__GIT_VIBE_CHDIR__=%s\n' "$1"
}

require_repo() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "run this command inside a Git repository"
}

repo_root() {
  git rev-parse --path-format=absolute --show-toplevel
}

primary_repo_root() {
  local common_dir
  common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"

  case "${common_dir}" in
    */.git)
      dirname "${common_dir}"
      ;;
    *)
      repo_root
      ;;
  esac
}

repo_name() {
  basename "$(primary_repo_root)"
}

git_config_get() {
  git config --get "$1" 2>/dev/null || true
}

base_branch() {
  local configured
  configured="$(git_config_get vibe.baseBranch)"
  printf '%s\n' "${configured:-main}"
}

branch_prefix() {
  local configured
  configured="$(git_config_get vibe.branchPrefix)"
  printf '%s\n' "${configured:-feat/}"
}

open_editor_mode() {
  local configured
  configured="$(git_config_get vibe.openEditor)"
  printf '%s\n' "${configured:-auto}"
}

workspace_app_setting() {
  local configured
  configured="$(git_config_get vibe.openWorkspaceWith)"
  printf '%s\n' "${configured:-auto}"
}

delete_remote_on_finish() {
  local configured
  configured="$(git config --bool --get vibe.deleteRemoteOnFinish 2>/dev/null || true)"
  printf '%s\n' "${configured:-false}"
}

issue_branch_style() {
  local configured
  configured="$(git_config_get vibe.issueBranchStyle)"
  printf '%s\n' "${configured:-number-and-title}"
}

validate_open_editor_mode() {
  case "$1" in
    auto|always|never)
      ;;
    *)
      die "invalid vibe.openEditor: $1 (expected auto, always, or never)"
      ;;
  esac
}

should_open_editor() {
  local mode
  mode="$1"
  validate_open_editor_mode "${mode}"

  case "${mode}" in
    always)
      return 0
      ;;
    never)
      return 1
      ;;
    auto)
      [[ -t 0 && -t 1 ]]
      ;;
  esac
}

validate_workspace_app() {
  case "$1" in
    auto|codex|vscode)
      ;;
    *)
      die "invalid vibe.openWorkspaceWith: $1 (expected auto, codex, or vscode)"
      ;;
  esac
}

validate_delete_remote_on_finish() {
  case "$1" in
    true|false)
      ;;
    *)
      die "invalid vibe.deleteRemoteOnFinish: $1 (expected true or false)"
      ;;
  esac
}

validate_issue_branch_style() {
  case "$1" in
    number-and-title|number-only|title-only)
      ;;
    *)
      die "invalid vibe.issueBranchStyle: $1 (expected number-and-title, number-only, or title-only)"
      ;;
  esac
}

in_codex_shell() {
  [[ "${CODEX_SHELL:-0}" == "1" || "${CODEX_INTERNAL_ORIGINATOR_OVERRIDE:-}" == "Codex Desktop" ]]
}

resolve_workspace_app() {
  local requested
  requested="$1"
  validate_workspace_app "${requested}"

  case "${requested}" in
    codex)
      command -v codex >/dev/null 2>&1 || die "Codex CLI not found; install 'codex' or choose --vscode"
      printf '%s\n' "codex"
      ;;
    vscode)
      command -v code >/dev/null 2>&1 || die "VS Code CLI 'code' not found; install it or choose --codex"
      printf '%s\n' "vscode"
      ;;
    auto)
      if in_codex_shell && command -v codex >/dev/null 2>&1; then
        printf '%s\n' "codex"
      elif command -v code >/dev/null 2>&1; then
        printf '%s\n' "vscode"
      elif command -v codex >/dev/null 2>&1; then
        printf '%s\n' "codex"
      else
        printf '\n'
      fi
      ;;
  esac
}

release_version_file() {
  local configured root
  configured="$(git_config_get vibe.releaseVersionFile)"
  if [[ -n "${configured}" ]]; then
    printf '%s\n' "${configured}"
    return 0
  fi

  root="$(repo_root)"
  if [[ -f "${root}/VERSION" ]]; then
    printf '%s\n' "VERSION"
  fi
}

worktree_root_setting() {
  local configured
  configured="$(git_config_get vibe.worktreeRoot)"
  printf '%s\n' "${configured:-../.vibe}"
}

current_branch() {
  git branch --show-current
}

slugify() {
  printf '%s' "$*" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-{2,}/-/g'
}

worktree_root() {
  local root repo
  repo="$(primary_repo_root)"
  root="$(worktree_root_setting)"

  if [[ "${root}" = /* ]]; then
    printf '%s\n' "${root}"
    return 0
  fi

  (
    cd "${repo}" >/dev/null 2>&1
    mkdir -p "${root}"
    cd "${root}" >/dev/null 2>&1
    pwd
  )
}

vibe_root() {
  printf '%s/%s\n' "$(worktree_root)" "$(repo_name)"
}

slug_from_name() {
  local slug
  slug="$(slugify "$*")"
  [[ -n "${slug}" ]] || die "feature name produced an empty slug"
  printf '%s\n' "${slug}"
}

is_issue_number_ref() {
  [[ $# -eq 1 && "$1" =~ ^[0-9]+$ ]]
}

issue_branch_key() {
  printf 'vibe.issue.%s.branch\n' "$1"
}

issue_title_key() {
  printf 'vibe.issue.%s.title\n' "$1"
}

issue_url_key() {
  printf 'vibe.issue.%s.url\n' "$1"
}

issue_branch_mapping() {
  git_config_get "$(issue_branch_key "$1")"
}

issue_title_mapping() {
  git_config_get "$(issue_title_key "$1")"
}

issue_url_mapping() {
  git_config_get "$(issue_url_key "$1")"
}

remember_issue_branch() {
  local number branch title url
  number="$1"
  branch="$2"
  title="$3"
  url="$4"

  git config "$(issue_branch_key "${number}")" "${branch}"
  git config "$(issue_title_key "${number}")" "${title}"
  git config "$(issue_url_key "${number}")" "${url}"
}

require_gh() {
  command -v gh >/dev/null 2>&1 || die "GitHub CLI 'gh' not found; install it to use issue-driven vibes"
}

fetch_issue_metadata() {
  local number
  number="$1"
  require_gh

  gh issue view "${number}" --json number,title,url --jq '[.number, .title, .url] | @tsv' \
    || die "could not read GitHub issue #${number}; check gh auth and repo issue access"
}

issue_slug_from_title() {
  local title_slug
  title_slug="$(slugify "$1")"
  [[ -n "${title_slug}" ]] || die "issue title produced an empty slug"
  printf '%s\n' "${title_slug}"
}

slug_from_issue() {
  local number title style title_slug
  number="$1"
  title="$2"
  style="$(issue_branch_style)"
  validate_issue_branch_style "${style}"
  title_slug="$(issue_slug_from_title "${title}")"

  case "${style}" in
    number-and-title)
      printf '%s-%s\n' "${number}" "${title_slug}"
      ;;
    number-only)
      printf '%s\n' "${number}"
      ;;
    title-only)
      printf '%s\n' "${title_slug}"
      ;;
  esac
}

branch_from_slug() {
  printf '%s%s\n' "$(branch_prefix)" "$1"
}

slug_from_branch() {
  local branch prefix
  branch="$1"
  prefix="$(branch_prefix)"
  printf '%s\n' "${branch#${prefix}}"
}

worktree_path_for_slug() {
  printf '%s/%s\n' "$(vibe_root)" "$1"
}

branch_matches_issue_number() {
  local number branch slug prefix
  number="$1"
  branch="$2"
  prefix="$(branch_prefix)"
  slug="${branch#${prefix}}"
  [[ "${branch}" == "${prefix}"* ]] || return 1
  [[ "${slug}" == "${number}" || "${slug}" == "${number}"-* ]]
}

find_issue_branch() {
  local number mapped branch
  local -a matches
  number="$1"
  mapped="$(issue_branch_mapping "${number}")"

  if [[ -n "${mapped}" ]] && { branch_exists "${mapped}" || remote_branch_exists "origin/${mapped}"; }; then
    printf '%s\n' "${mapped}"
    return 0
  fi

  matches=()
  while IFS= read -r branch; do
    branch_matches_issue_number "${number}" "${branch}" || continue
    matches+=("${branch}")
  done < <(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes/origin | sed 's#^origin/##' | sort -u)

  if [[ ${#matches[@]} -gt 1 ]]; then
    die "multiple vibe branches match issue #${number}: ${matches[*]}"
  fi

  if [[ ${#matches[@]} -eq 1 ]]; then
    printf '%s\n' "${matches[0]}"
    return 0
  fi

  return 1
}

issue_number_for_branch() {
  local line key number_branch branch number
  branch="$1"

  while IFS= read -r line; do
    key="${line%% *}"
    number_branch="${line#* }"
    [[ "${number_branch}" == "${branch}" ]] || continue
    number="${key#vibe.issue.}"
    number="${number%.branch}"
    printf '%s\n' "${number}"
    return 0
  done < <(git config --get-regexp '^vibe\.issue\.[0-9]+\.branch$' 2>/dev/null || true)

  return 1
}

session_slug_for_branch() {
  slug_from_branch "$1"
}

session_key() {
  local branch field
  branch="$1"
  field="$2"
  printf 'vibe.session.%s.%s\n' "$(session_slug_for_branch "${branch}")" "${field}"
}

session_agent_for_branch() {
  git_config_get "$(session_key "$1" agent)"
}

session_task_for_branch() {
  git_config_get "$(session_key "$1" task)"
}

session_updated_at_for_branch() {
  git_config_get "$(session_key "$1" updatedAt)"
}

session_has_metadata() {
  local branch
  branch="$1"
  [[ -n "$(session_agent_for_branch "${branch}")" || -n "$(session_task_for_branch "${branch}")" || -n "$(session_updated_at_for_branch "${branch}")" ]]
}

timestamp_utc() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

default_session_agent() {
  if in_codex_shell; then
    printf '%s\n' "codex"
  fi
}

remember_session_metadata() {
  local branch agent task updated_at
  branch="$1"
  agent="$2"
  task="$3"
  updated_at="$(timestamp_utc)"

  if [[ -n "${agent}" ]]; then
    git config "$(session_key "${branch}" agent)" "${agent}"
  else
    git config --unset-all "$(session_key "${branch}" agent)" >/dev/null 2>&1 || true
  fi

  if [[ -n "${task}" ]]; then
    git config "$(session_key "${branch}" task)" "${task}"
  else
    git config --unset-all "$(session_key "${branch}" task)" >/dev/null 2>&1 || true
  fi

  if [[ -n "${agent}" || -n "${task}" ]]; then
    git config "$(session_key "${branch}" updatedAt)" "${updated_at}"
  else
    git config --unset-all "$(session_key "${branch}" updatedAt)" >/dev/null 2>&1 || true
  fi
}

touch_session_metadata() {
  local branch
  branch="$1"

  session_has_metadata "${branch}" || return 0
  git config "$(session_key "${branch}" updatedAt)" "$(timestamp_utc)"
}

clear_session_metadata() {
  local branch
  branch="$1"
  git config --unset-all "$(session_key "${branch}" agent)" >/dev/null 2>&1 || true
  git config --unset-all "$(session_key "${branch}" task)" >/dev/null 2>&1 || true
  git config --unset-all "$(session_key "${branch}" updatedAt)" >/dev/null 2>&1 || true
}

truncate_text() {
  local text limit
  text="$1"
  limit="$2"

  if (( ${#text} <= limit )); then
    printf '%s\n' "${text}"
  elif (( limit <= 3 )); then
    printf '%s\n' "${text:0:limit}"
  else
    printf '%s...\n' "${text:0:$((limit - 3))}"
  fi
}

session_summary_for_branch() {
  local branch agent task
  branch="$1"
  agent="$(session_agent_for_branch "${branch}")"
  task="$(session_task_for_branch "${branch}")"

  if [[ -n "${agent}" && -n "${task}" ]]; then
    printf '%s\n' "${agent}: $(truncate_text "${task}" 24)"
  elif [[ -n "${task}" ]]; then
    truncate_text "${task}" 32
  elif [[ -n "${agent}" ]]; then
    printf '%s\n' "${agent}"
  else
    printf '%s\n' "-"
  fi
}

print_session_context() {
  local branch mode agent task updated_at
  branch="$1"
  mode="${2:-optional}"
  agent="$(session_agent_for_branch "${branch}")"
  task="$(session_task_for_branch "${branch}")"
  updated_at="$(session_updated_at_for_branch "${branch}")"

  if [[ -z "${agent}" && -z "${task}" && -z "${updated_at}" ]]; then
    if [[ "${mode}" == "always" ]]; then
      say "  Session: none recorded"
    fi
    return 0
  fi

  if [[ -n "${agent}" ]]; then
    say "  Session: ${agent}"
  else
    say "  Session: recorded"
  fi

  if [[ -n "${task}" ]]; then
    say "  Task: ${task}"
  fi

  if [[ -n "${updated_at}" ]]; then
    say "  Last activity: ${updated_at}"
  fi
}

titleize_slug() {
  printf '%s\n' "$1" | tr '-' ' ' | awk '{
    for (i = 1; i <= NF; i++) {
      $i = toupper(substr($i, 1, 1)) substr($i, 2)
    }
    print
  }'
}

strip_semantic_prefix() {
  printf '%s\n' "$1" | sed -E 's/^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|release)(\([a-z0-9._/-]+\))?(!)?: //'
}

recent_commit_subjects_for_branch() {
  local base branch merge_base
  branch="$1"
  base="$(base_branch)"
  merge_base="$(git merge-base "${base}" "${branch}")"
  git log --format='%s' "${merge_base}..${branch}" | sed '/^[[:space:]]*$/d'
}

default_pr_title() {
  local branch issue_number issue_title first_subject stripped slug
  branch="$1"
  issue_number="$(issue_number_for_branch "${branch}" || true)"

  if [[ -n "${issue_number}" ]]; then
    issue_title="$(issue_title_mapping "${issue_number}")"
    if [[ -n "${issue_title}" ]]; then
      printf '%s\n' "${issue_title}"
      return 0
    fi
  fi

  first_subject="$(recent_commit_subjects_for_branch "${branch}" | head -n 1 || true)"
  if [[ -n "${first_subject}" ]]; then
    stripped="$(strip_semantic_prefix "${first_subject}")"
    printf '%s\n' "${stripped:-${first_subject}}"
    return 0
  fi

  slug="$(slug_from_branch "${branch}")"
  printf '%s\n' "$(titleize_slug "${slug}")"
}

default_pr_body() {
  local branch issue_number subject stripped emitted
  branch="$1"
  issue_number="$(issue_number_for_branch "${branch}" || true)"
  emitted="false"

  printf '## Summary\n'
  while IFS= read -r subject; do
    [[ -n "${subject}" ]] || continue
    stripped="$(strip_semantic_prefix "${subject}")"
    printf -- '- %s\n' "${stripped:-${subject}}"
    emitted="true"
  done < <(recent_commit_subjects_for_branch "${branch}" | head -n 5)

  if [[ "${emitted}" == "false" ]]; then
    printf -- '- describe the change\n'
  fi

  if [[ -n "${issue_number}" ]]; then
    printf '\nCloses #%s\n' "${issue_number}"
  fi
}

ensure_branch_pushed() {
  local branch path
  branch="$1"

  git remote get-url origin >/dev/null 2>&1 || die "origin remote is not configured"
  path="$(find_worktree_for_branch "${branch}" || true)"
  [[ -n "${path}" ]] || path="$(repo_root)"

  if ! remote_branch_exists "origin/${branch}"; then
    git -C "${path}" push -u origin "${branch}" >/dev/null || die "could not push ${branch} to origin"
    return 0
  fi

  git -C "${path}" branch --set-upstream-to "origin/${branch}" "${branch}" >/dev/null 2>&1 || true
}

fetch_pr_summary() {
  local branch
  branch="$1"
  command -v gh >/dev/null 2>&1 || return 1

  gh pr view "${branch}" \
    --json number,title,url,state,isDraft,reviewDecision \
    --jq '[.number, .title, .url, .state, (if .isDraft then "draft" else "ready" end), (.reviewDecision // "")] | @tsv' \
    2>/dev/null
}

fetch_pr_checks_summary() {
  local branch
  branch="$1"
  command -v gh >/dev/null 2>&1 || return 1

  gh pr checks "${branch}" \
    --json bucket \
    --jq 'map(.bucket) | if length == 0 then "" else group_by(.) | map("\(.[0]):\(length)") | join(", ") end' \
    2>/dev/null
}

fetch_pr_checks_detail() {
  local branch
  branch="$1"
  command -v gh >/dev/null 2>&1 || return 1

  gh pr checks "${branch}" \
    --json bucket,state,name,link \
    --jq '.[] | [.bucket, .state, .name, (.link // "")] | @tsv' \
    2>/dev/null
}

print_pr_context() {
  local branch summary checks_summary number title url state draft_state review
  branch="$1"

  summary="$(fetch_pr_summary "${branch}" || true)"
  if [[ -z "${summary}" ]]; then
    say "  PR: none"
    return 0
  fi

  IFS=$'\t' read -r number title url state draft_state review <<< "${summary}"

  say "  PR: #${number} ${title}"
  say "  PR URL: ${url}"
  if [[ -n "${review}" ]]; then
    say "  PR State: ${state}, ${draft_state}, review ${review}"
  else
    say "  PR State: ${state}, ${draft_state}"
  fi

  checks_summary="$(fetch_pr_checks_summary "${branch}" || true)"
  if [[ -n "${checks_summary}" ]]; then
    say "  Checks: ${checks_summary}"
  else
    say "  Checks: none reported"
  fi
}

ensure_clean_tree() {
  local path
  path="$1"
  [[ -d "${path}" ]] || return 0

  if [[ -n "$(git -C "${path}" status --porcelain)" ]]; then
    die "worktree at ${path} has uncommitted changes"
  fi
}

branch_exists() {
  git show-ref --verify --quiet "refs/heads/$1"
}

tag_exists() {
  git show-ref --verify --quiet "refs/tags/$1"
}

push_blocked_on_base() {
  local disallow allow
  disallow="$(git config --bool --get vibe.disallowPushOnBase 2>/dev/null || true)"
  if [[ "${disallow}" == "true" ]]; then
    printf '%s\n' "true"
    return 0
  fi

  # Backward compatibility for older installs that used allowPushOnBase.
  allow="$(git config --bool --get vibe.allowPushOnBase 2>/dev/null || true)"
  if [[ "${allow}" == "false" ]]; then
    printf '%s\n' "true"
    return 0
  fi

  printf '%s\n' "false"
}

remote_branch_exists() {
  git show-ref --verify --quiet "refs/remotes/$1"
}

prune_remote_tracking_branch() {
  local branch
  branch="$1"
  git update-ref -d "refs/remotes/origin/${branch}" >/dev/null 2>&1 || true
}

delete_remote_branch() {
  local branch output
  branch="$1"

  if ! git remote get-url origin >/dev/null 2>&1; then
    say "Remote branch: skipped (origin not configured)"
    return 0
  fi

  if ! remote_branch_exists "origin/${branch}"; then
    prune_remote_tracking_branch "${branch}"
    say "Remote branch: already absent (origin/${branch})"
    return 0
  fi

  output="$(git push origin --delete "${branch}" 2>&1)" || {
    if [[ "${output}" == *"remote ref does not exist"* || "${output}" == *"remote ref not found"* || "${output}" == *"couldn't find remote ref"* ]]; then
      prune_remote_tracking_branch "${branch}"
      say "Remote branch: already absent (origin/${branch})"
      return 0
    fi

    printf '%s\n' "${output}" >&2
    die "could not delete origin/${branch}"
  }

  prune_remote_tracking_branch "${branch}"
  say "Remote branch: deleted origin/${branch}"
}

is_ancestor_of() {
  git merge-base --is-ancestor "$1" "$2" >/dev/null 2>&1
}

find_worktree_for_branch() {
  local target path branch line
  target="refs/heads/$1"
  path=""
  branch=""

  while IFS= read -r line; do
    case "${line}" in
      worktree\ *)
        path="${line#worktree }"
        ;;
      branch\ *)
        branch="${line#branch }"
        ;;
      "")
        if [[ "${branch}" == "${target}" ]]; then
          printf '%s\n' "${path}"
          return 0
        fi
        path=""
        branch=""
        ;;
    esac
  done < <(git worktree list --porcelain; printf '\n')

  return 1
}

worktree_records_raw() {
  local path branch head detached bare locked prunable locked_reason prunable_reason line
  path=""
  branch=""
  head=""
  detached="false"
  bare="false"
  locked="false"
  prunable="false"
  locked_reason=""
  prunable_reason=""

  while IFS= read -r line; do
    case "${line}" in
      worktree\ *)
        path="${line#worktree }"
        ;;
      branch\ refs/heads/*)
        branch="${line#branch refs/heads/}"
        ;;
      HEAD\ *)
        head="${line#HEAD }"
        ;;
      detached)
        detached="true"
        ;;
      bare)
        bare="true"
        ;;
      locked\ *)
        locked="true"
        locked_reason="${line#locked }"
        ;;
      locked)
        locked="true"
        locked_reason=""
        ;;
      prunable\ *)
        prunable="true"
        prunable_reason="${line#prunable }"
        ;;
      prunable)
        prunable="true"
        prunable_reason=""
        ;;
      "")
        if [[ -n "${path}" ]]; then
          printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "${branch}" \
            "${path}" \
            "${head}" \
            "${detached}" \
            "${bare}" \
            "${locked}" \
            "${locked_reason}" \
            "${prunable}" \
            "${prunable_reason}"
        fi
        path=""
        branch=""
        head=""
        detached="false"
        bare="false"
        locked="false"
        prunable="false"
        locked_reason=""
        prunable_reason=""
        ;;
    esac
  done < <(git worktree list --porcelain; printf '\n')
}

list_vibes_raw() {
  local prefix branch path head detached bare locked locked_reason prunable prunable_reason
  prefix="$(branch_prefix)"

  while IFS=$'\t' read -r branch path head detached bare locked locked_reason prunable prunable_reason; do
    if [[ -n "${branch}" && "${branch}" == "${prefix}"* ]]; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "${branch}" \
        "${path}" \
        "${head}" \
        "${detached}" \
        "${bare}" \
        "${locked}" \
        "${locked_reason}" \
        "${prunable}" \
        "${prunable_reason}"
    fi
  done < <(worktree_records_raw)
}

is_vibe_branch() {
  local branch prefix
  branch="$1"
  prefix="$(branch_prefix)"
  [[ -n "${branch}" && "${branch}" == "${prefix}"* ]]
}

resolve_vibe_branch() {
  local branch slug

  if is_issue_number_ref "$@"; then
    branch="$(find_issue_branch "$1" || true)"
    if [[ -n "${branch}" ]]; then
      printf '%s\n' "${branch}"
      return 0
    fi
  fi

  if [[ $# -gt 0 ]]; then
    slug="$(slug_from_name "$*")"
    branch="$(branch_from_slug "${slug}")"
    branch_exists "${branch}" || die "vibe branch not found: ${branch}"
    printf '%s\n' "${branch}"
    return 0
  fi

  branch="$(current_branch)"
  is_vibe_branch "${branch}" || die "run this command inside a vibe worktree or pass a vibe name"
  printf '%s\n' "${branch}"
}

worktree_path_for_branch() {
  local branch path
  branch="$1"
  path="$(find_worktree_for_branch "${branch}" || true)"

  if [[ -n "${path}" ]]; then
    printf '%s\n' "${path}"
    return 0
  fi

  if [[ "$(current_branch)" == "${branch}" ]]; then
    repo_root
    return 0
  fi

  die "worktree not found for ${branch}"
}

worktree_path_exists() {
  local path
  path="$1"
  [[ -d "${path}" ]]
}

accessible_worktree_path() {
  local path
  path="$1"
  worktree_path_exists "${path}" && git -C "${path}" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

vibe_merge_base() {
  local base path branch
  base="$1"
  path="$2"
  branch="${3:-}"

  if accessible_worktree_path "${path}"; then
    git -C "${path}" merge-base "${base}" HEAD
    return 0
  fi

  if [[ -n "${branch}" ]]; then
    git merge-base "${base}" "${branch}"
    return 0
  fi

  return 1
}

vibe_diff_shortstat() {
  local merge_base path
  merge_base="$1"
  path="$2"

  accessible_worktree_path "${path}" || return 0
  [[ -n "${merge_base}" ]] || return 0
  git -C "${path}" diff --shortstat "${merge_base}" || true
}

vibe_dirty_count() {
  local path
  path="$1"

  accessible_worktree_path "${path}" || {
    printf '%s\n' "-"
    return 0
  }

  git -C "${path}" status --porcelain | wc -l | tr -d ' '
}

vibe_untracked_files() {
  local path
  path="$1"

  accessible_worktree_path "${path}" || return 0
  git -C "${path}" ls-files --others --exclude-standard
}

vibe_ahead_behind_summary() {
  local base branch behind ahead
  base="$1"
  branch="$2"
  read -r behind ahead < <(git rev-list --left-right --count "${base}...${branch}" 2>/dev/null || printf '0 0\n')
  printf '+%s/-%s\n' "${ahead:-0}" "${behind:-0}"
}

worktree_state_label() {
  local path locked prunable dirty_count
  local -a labels
  path="$1"
  locked="$2"
  prunable="$3"
  labels=()

  if [[ "${prunable}" == "true" ]]; then
    labels+=("prunable")
  elif ! accessible_worktree_path "${path}"; then
    labels+=("missing")
  else
    dirty_count="$(vibe_dirty_count "${path}")"
    if [[ "${dirty_count}" == "0" ]]; then
      labels+=("clean")
    else
      labels+=("dirty:${dirty_count}")
    fi
  fi

  if [[ "${locked}" == "true" ]]; then
    labels+=("locked")
  fi

  (
    IFS=,
    printf '%s\n' "${labels[*]}"
  )
}

worktree_change_summary() {
  local base branch path merge_base diff_summary untracked_count
  base="$1"
  branch="$2"
  path="$3"

  if ! accessible_worktree_path "${path}"; then
    printf '%s\n' "-"
    return 0
  fi

  merge_base="$(vibe_merge_base "${base}" "${path}" "${branch}" || true)"
  [[ -n "${merge_base}" ]] || {
    printf '%s\n' "-"
    return 0
  }

  diff_summary="$(vibe_diff_shortstat "${merge_base}" "${path}")"
  untracked_count="$(vibe_untracked_files "${path}" | wc -l | tr -d ' ')"

  if [[ -n "${diff_summary}" ]]; then
    printf '%s\n' "${diff_summary}"
  elif [[ "${untracked_count}" != "0" ]]; then
    printf '%s untracked file(s)\n' "${untracked_count}"
  else
    printf '%s\n' "none"
  fi
}

print_vibe_context() {
  local branch path base merge_base diff_summary dirty_count behind ahead untracked_count issue_number issue_title issue_url
  branch="$1"
  path="$2"
  base="$(base_branch)"
  merge_base="$(vibe_merge_base "${base}" "${path}" "${branch}" || true)"
  diff_summary="$(vibe_diff_shortstat "${merge_base}" "${path}")"
  dirty_count="$(vibe_dirty_count "${path}")"
  untracked_count="$(vibe_untracked_files "${path}" | wc -l | tr -d ' ')"
  read -r behind ahead < <(git rev-list --left-right --count "${base}...${branch}" 2>/dev/null || printf '0 0\n')

  say "Context:"
  say "  Branch: ${branch}"
  say "  Base: ${base}"
  say "  Path: ${path}"
  say "  Compare: ${base}...${branch}"
  say "  Ahead/behind vs ${base}: +${ahead}/-${behind}"

  issue_number="$(issue_number_for_branch "${branch}" || true)"
  if [[ -n "${issue_number}" ]]; then
    issue_title="$(issue_title_mapping "${issue_number}")"
    issue_url="$(issue_url_mapping "${issue_number}")"
    if [[ -n "${issue_title}" ]]; then
      say "  Issue: #${issue_number} ${issue_title}"
    else
      say "  Issue: #${issue_number}"
    fi
    if [[ -n "${issue_url}" ]]; then
      say "  Issue URL: ${issue_url}"
    fi
  fi

  print_session_context "${branch}"

  if ! accessible_worktree_path "${path}"; then
    say "  Working tree: unavailable (worktree path missing)"
  elif [[ "${dirty_count}" == "0" ]]; then
    say "  Working tree: clean"
  else
    say "  Working tree: ${dirty_count} uncommitted change(s)"
  fi

  if ! accessible_worktree_path "${path}"; then
    say "  Changes vs ${base}: unavailable"
  elif [[ -n "${diff_summary}" ]]; then
    say "  Changes vs ${base}: ${diff_summary}"
  elif [[ "${untracked_count}" != "0" ]]; then
    say "  Changes vs ${base}: ${untracked_count} untracked file(s)"
  else
    say "  Changes vs ${base}: none"
  fi
}

base_worktree_path() {
  local base path
  base="$(base_branch)"
  path="$(find_worktree_for_branch "${base}" || true)"
  if [[ -n "${path}" ]]; then
    printf '%s\n' "${path}"
    return 0
  fi

  if [[ "$(current_branch)" == "${base}" ]]; then
    repo_root
    return 0
  fi

  return 1
}

sync_base_branch() {
  local base base_path
  base="$(base_branch)"
  base_path="$(base_worktree_path || true)"
  [[ -n "${base_path}" ]] || return 0

  ensure_clean_tree "${base_path}"
  git -C "${base_path}" switch "${base}" >/dev/null 2>&1 || true

  if remote_branch_exists "origin/${base}"; then
    git -C "${base_path}" merge --ff-only "origin/${base}" >/dev/null
  fi
}

run_fetch() {
  local base
  base="$(base_branch)"

  git remote get-url origin >/dev/null 2>&1 || die "origin remote is not configured"
  git fetch origin "${base}"
}

push_base_branch_and_tags() {
  local base
  base="$1"

  git remote get-url origin >/dev/null 2>&1 || die "origin remote is not configured"
  VIBE_ALLOW_PUSH_BASE=1 git push origin "${base}" --tags
}

normalize_release_version() {
  local normalized
  normalized="${1#v}"

  if [[ ! "${normalized}" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]]; then
    die "release version must look like 0.0.2 or v0.0.2"
  fi

  printf '%s\n' "${normalized}"
}

print_help() {
  cat <<'EOF'
Git Vibe

Usage:
  git vibe code [--editor|--no-editor] [--codex|--vscode] [--agent <agent>] [--task <task>] <name>
  git vibe issue [--editor|--no-editor] [--codex|--vscode] [--agent <agent>] [--task <task>] <number>
  git vibe session [--agent <agent>] [--task <task>] [--clear] [name]
  git vibe pr [--draft] [--web] [--title <title>] [--body <body>] [name]
  git vibe submit [--draft] [--web] [--title <title>] [--body <body>] [name]
  git vibe checks [name]
  git vibe enter [name]
  git vibe open [--codex|--vscode] [name]
  git vibe diff [name]
  git vibe finish [--local] [--sync] [--delete-remote|--keep-remote] [name]
  git vibe release <version> [--push]
  git vibe ship <version> [--push]
  git vibe list
  git vibe status [name]
  git vibe check [name]
  git vibe path <name>
  git vibe doctor [--repair]
  git vibe prune
  git vibe version
  git vibe hook <pre-commit|commit-msg|pre-push> [args...]

Examples:
  git vibe code fallback-app-urls
  git vibe code --agent codex --task "fix login redirect" fallback-app-urls
  git vibe code 9
  git vibe issue 9
  git vibe session --task "polish the docs" 9
  git vibe pr
  git vibe submit 10
  git vibe checks 10
  git vibe code --codex fallback-app-urls
  git vibe code --no-editor fallback-app-urls
  git vibe enter fallback-app-urls
  git vibe open fallback-app-urls
  git vibe diff fallback-app-urls
  git vibe doctor
  git vibe doctor --repair
  git vibe finish fallback-app-urls
  git vibe finish --delete-remote fallback-app-urls
  git vibe finish --sync fallback-app-urls
  git vibe finish --local fallback-app-urls
  git vibe release 0.0.2
  git vibe ship 0.0.2 --push
  git vibe release 0.0.2 --push
EOF
}

open_workspace_for_path() {
  local path app
  path="$1"
  app="$2"

  case "${app}" in
    codex)
      if codex app "${path}" >/dev/null 2>&1; then
        say "Workspace: opened in Codex Desktop"
      else
        say "Workspace: launch failed (Codex Desktop)"
      fi
      ;;
    vscode)
      if [[ "${TERM_PROGRAM:-}" == "vscode" ]]; then
        if code -r "${path}" >/dev/null 2>&1 || code "${path}" >/dev/null 2>&1; then
          say "Workspace: opened in VS Code"
        else
          say "Workspace: launch failed (VS Code)"
        fi
        return 0
      fi

      if code "${path}" >/dev/null 2>&1; then
        say "Workspace: opened in VS Code"
      else
        say "Workspace: launch failed (VS Code)"
      fi
      ;;
  esac
}

command_code() {
  local name slug branch base path shell_output open_editor action base_path editor_mode workspace_app workspace_app_override
  local session_agent session_task current_session_agent current_session_task final_session_agent final_session_task detected_session_agent
  local agent_set task_set
  local issue_number issue_title issue_url issue_metadata
  local -a name_parts
  require_repo

  shell_output="false"
  open_editor=""
  workspace_app_override=""
  session_agent=""
  session_task=""
  agent_set="false"
  task_set="false"
  name_parts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --shell-output)
        shell_output="true"
        ;;
      --editor)
        open_editor="always"
        ;;
      --no-editor)
        open_editor="never"
        ;;
      --codex)
        workspace_app_override="codex"
        ;;
      --vscode)
        workspace_app_override="vscode"
        ;;
      --agent)
        shift
        [[ $# -gt 0 ]] || die "--agent requires a value"
        session_agent="$1"
        agent_set="true"
        ;;
      --task)
        shift
        [[ $# -gt 0 ]] || die "--task requires a value"
        session_task="$1"
        task_set="true"
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      *)
        name_parts+=("$1")
        ;;
    esac
    shift
  done

  [[ ${#name_parts[@]} -gt 0 ]] || die "code requires a feature name"

  name="${name_parts[*]}"
  issue_number=""
  issue_title=""
  issue_url=""

  if is_issue_number_ref "${name_parts[@]}"; then
    issue_number="${name_parts[0]}"
    branch="$(find_issue_branch "${issue_number}" || true)"

    if [[ -n "${branch}" ]]; then
      slug="$(slug_from_branch "${branch}")"
      issue_title="$(issue_title_mapping "${issue_number}")"
      issue_url="$(issue_url_mapping "${issue_number}")"
    else
      issue_metadata="$(fetch_issue_metadata "${issue_number}")"
      IFS=$'\t' read -r issue_number issue_title issue_url <<< "${issue_metadata}"
      slug="$(slug_from_issue "${issue_number}" "${issue_title}")"
      branch="$(branch_from_slug "${slug}")"
    fi
  else
    slug="$(slug_from_name "${name}")"
    branch="$(branch_from_slug "${slug}")"
  fi

  base="$(base_branch)"
  path="$(worktree_path_for_slug "${slug}")"
  action="Opened"

  if find_worktree_for_branch "${branch}" >/dev/null 2>&1; then
    path="$(find_worktree_for_branch "${branch}")"
  elif branch_exists "${branch}"; then
    if [[ -e "${path}" ]]; then
      die "worktree path already exists: ${path}"
    fi
    mkdir -p "$(vibe_root)"
    git worktree add "${path}" "${branch}"
    action="Attached"
  elif remote_branch_exists "origin/${branch}"; then
    if [[ -e "${path}" ]]; then
      die "worktree path already exists: ${path}"
    fi
    mkdir -p "$(vibe_root)"
    git worktree add -b "${branch}" "${path}" "origin/${branch}"
    git -C "${path}" branch --set-upstream-to "origin/${branch}" "${branch}" >/dev/null 2>&1 || true
    action="Checked out"
  else
    branch_exists "${base}" || die "base branch ${base} does not exist locally"
    base_path="$(base_worktree_path || true)"

    if [[ -n "${base_path}" ]]; then
      ensure_clean_tree "${base_path}"
      git -C "${base_path}" switch "${base}" >/dev/null 2>&1 || true
    fi

    if [[ -e "${path}" ]]; then
      die "worktree path already exists: ${path}"
    fi

    mkdir -p "$(vibe_root)"
    git worktree add -b "${branch}" "${path}" "${base}"
    action="Started"
  fi

  if [[ -n "${issue_number}" ]]; then
    remember_issue_branch "${issue_number}" "${branch}" "${issue_title}" "${issue_url}"
  fi

  if [[ "${agent_set}" == "true" || "${task_set}" == "true" ]]; then
    current_session_agent="$(session_agent_for_branch "${branch}")"
    current_session_task="$(session_task_for_branch "${branch}")"
    final_session_agent="${current_session_agent}"
    final_session_task="${current_session_task}"

    if [[ "${agent_set}" == "true" ]]; then
      final_session_agent="${session_agent}"
    fi

    if [[ "${task_set}" == "true" ]]; then
      final_session_task="${session_task}"
      if [[ -z "${final_session_agent}" ]]; then
        detected_session_agent="$(default_session_agent)"
        if [[ -n "${detected_session_agent}" ]]; then
          final_session_agent="${detected_session_agent}"
        fi
      fi
    fi

    remember_session_metadata "${branch}" "${final_session_agent}" "${final_session_task}"
  else
    touch_session_metadata "${branch}"
  fi

  say "${action} ${branch}"
  say "Path: ${path}"
  print_vibe_context "${branch}" "${path}"
  say ""
  say "Next:"
  say "  git vibe enter ${slug}"
  say "  git vibe open ${slug}"
  say "  git -C ${path} status --short"
  say "  git vibe diff ${slug}"

  editor_mode="$(open_editor_mode)"
  if [[ -n "${open_editor}" ]]; then
    editor_mode="${open_editor}"
  fi

  if should_open_editor "${editor_mode}"; then
    workspace_app="$(workspace_app_setting)"
    if [[ -n "${workspace_app_override}" ]]; then
      workspace_app="${workspace_app_override}"
    fi
    workspace_app="$(resolve_workspace_app "${workspace_app}")"
    if [[ -n "${workspace_app}" ]]; then
      open_workspace_for_path "${path}" "${workspace_app}"
    else
      say "Workspace: skipped (no supported app found)"
    fi
  fi

  if [[ "${shell_output}" == "true" ]]; then
    say_shell_chdir "${path}"
  fi
}

command_start() {
  command_code --no-editor "$@"
}

command_issue() {
  local -a passthrough name_parts
  passthrough=("$@")
  name_parts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --shell-output|--editor|--no-editor|--codex|--vscode)
        ;;
      --agent|--task)
        local flag_name
        flag_name="$1"
        shift
        [[ $# -gt 0 ]] || die "${flag_name} requires a value"
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      *)
        name_parts+=("$1")
        ;;
    esac
    shift
  done

  if ! is_issue_number_ref "${name_parts[@]}"; then
    die "issue requires a GitHub issue number"
  fi

  command_code "${passthrough[@]}"
}

command_session() {
  local branch session_agent session_task current_session_agent current_session_task final_session_agent final_session_task detected_session_agent
  local agent_set task_set clear
  local -a name_parts
  require_repo

  session_agent=""
  session_task=""
  agent_set="false"
  task_set="false"
  clear="false"
  name_parts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent)
        shift
        [[ $# -gt 0 ]] || die "--agent requires a value"
        session_agent="$1"
        agent_set="true"
        ;;
      --task)
        shift
        [[ $# -gt 0 ]] || die "--task requires a value"
        session_task="$1"
        task_set="true"
        ;;
      --clear)
        clear="true"
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      *)
        name_parts+=("$1")
        ;;
    esac
    shift
  done

  branch="$(resolve_vibe_branch "${name_parts[@]}")"

  if [[ "${clear}" == "true" ]]; then
    clear_session_metadata "${branch}"
    say "Cleared session metadata for ${branch}"
    say "Session:"
    print_session_context "${branch}" "always"
    return 0
  fi

  if [[ "${agent_set}" != "true" && "${task_set}" != "true" ]]; then
    touch_session_metadata "${branch}"
    say "Session for ${branch}:"
    print_session_context "${branch}" "always"
    return 0
  fi

  current_session_agent="$(session_agent_for_branch "${branch}")"
  current_session_task="$(session_task_for_branch "${branch}")"
  final_session_agent="${current_session_agent}"
  final_session_task="${current_session_task}"

  if [[ "${agent_set}" == "true" ]]; then
    final_session_agent="${session_agent}"
  fi

  if [[ "${task_set}" == "true" ]]; then
    final_session_task="${session_task}"
  fi

  if [[ -z "${final_session_agent}" && -n "${final_session_task}" ]]; then
    detected_session_agent="$(default_session_agent)"
    if [[ -n "${detected_session_agent}" ]]; then
      final_session_agent="${detected_session_agent}"
    fi
  fi

  remember_session_metadata "${branch}" "${final_session_agent}" "${final_session_task}"
  say "Updated session for ${branch}"
  print_session_context "${branch}" "always"
}

command_pr() {
  local branch base draft web title body pr_title pr_body pr_url
  local -a name_parts
  require_repo
  require_gh

  draft="false"
  web="false"
  title=""
  body=""
  name_parts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --draft)
        draft="true"
        ;;
      --web)
        web="true"
        ;;
      --title)
        shift
        [[ $# -gt 0 ]] || die "--title requires a value"
        title="$1"
        ;;
      --body)
        shift
        [[ $# -gt 0 ]] || die "--body requires a value"
        body="$1"
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      *)
        name_parts+=("$1")
        ;;
    esac
    shift
  done

  branch="$(resolve_vibe_branch "${name_parts[@]}")"
  touch_session_metadata "${branch}"
  base="$(base_branch)"
  ensure_branch_pushed "${branch}"

  if [[ "${web}" == "true" ]]; then
    if [[ "${draft}" == "true" ]]; then
      gh pr create --base "${base}" --head "${branch}" --draft --web
    else
      gh pr create --base "${base}" --head "${branch}" --web
    fi
    say "Opened PR creation for ${branch}"
    return 0
  fi

  pr_title="${title:-$(default_pr_title "${branch}")}"
  pr_body="${body:-$(default_pr_body "${branch}")}"

  if [[ "${draft}" == "true" ]]; then
    pr_url="$(gh pr create --base "${base}" --head "${branch}" --draft --title "${pr_title}" --body "${pr_body}")" \
      || die "could not create a pull request for ${branch}"
  else
    pr_url="$(gh pr create --base "${base}" --head "${branch}" --title "${pr_title}" --body "${pr_body}")" \
      || die "could not create a pull request for ${branch}"
  fi

  say "Created PR for ${branch}"
  say "Title: ${pr_title}"
  say "URL: ${pr_url}"
}

command_submit() {
  command_pr "$@"
}

command_enter() {
  local branch path shell_output
  local -a name_parts
  require_repo

  shell_output="false"
  name_parts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --shell-output)
        shell_output="true"
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      *)
        name_parts+=("$1")
        ;;
    esac
    shift
  done

  branch="$(resolve_vibe_branch "${name_parts[@]}")"
  touch_session_metadata "${branch}"
  path="$(worktree_path_for_branch "${branch}")"

  say "Entering ${branch}"
  say "Path: ${path}"
  print_vibe_context "${branch}" "${path}"

  if [[ "${shell_output}" == "true" ]]; then
    say_shell_chdir "${path}"
  fi
}

command_open() {
  local branch path workspace_app
  local -a name_parts
  require_repo

  workspace_app="$(workspace_app_setting)"
  name_parts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --codex)
        workspace_app="codex"
        ;;
      --vscode)
        workspace_app="vscode"
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      *)
        name_parts+=("$1")
        ;;
    esac
    shift
  done

  branch="$(resolve_vibe_branch "${name_parts[@]}")"
  touch_session_metadata "${branch}"
  path="$(worktree_path_for_branch "${branch}")"
  workspace_app="$(resolve_workspace_app "${workspace_app}")"
  [[ -n "${workspace_app}" ]] || die "no supported workspace app found; install 'code' or 'codex'"

  say "Opening ${branch}"
  say "Path: ${path}"
  print_vibe_context "${branch}" "${path}"
  open_workspace_for_path "${path}" "${workspace_app}"
}

command_checks() {
  local branch checks_output bucket state name link
  require_repo

  branch="$(resolve_vibe_branch "$@")"
  touch_session_metadata "${branch}"
  checks_output="$(fetch_pr_checks_detail "${branch}" || true)"

  if [[ -z "${checks_output}" ]]; then
    say "No PR checks found for ${branch}"
    return 0
  fi

  say "Checks for ${branch}:"
  printf '%-10s %-12s %s\n' "BUCKET" "STATE" "NAME"
  while IFS=$'\t' read -r bucket state name link; do
    printf '%-10s %-12s %s\n' "${bucket}" "${state}" "${name}"
  done <<< "${checks_output}"
}

command_diff() {
  local branch path base merge_base untracked_files
  require_repo

  branch="$(resolve_vibe_branch "$@")"
  touch_session_metadata "${branch}"
  path="$(worktree_path_for_branch "${branch}")"
  base="$(base_branch)"
  merge_base="$(vibe_merge_base "${base}" "${path}")"

  git -C "${path}" diff "${merge_base}"

  untracked_files="$(vibe_untracked_files "${path}")"
  if [[ -n "${untracked_files}" ]]; then
    say ""
    say "Untracked files:"
    printf '%s\n' "${untracked_files}"
  fi
}

command_finish() {
  local name branch slug path mode sync base merged_into shell_output base_path delete_remote delete_remote_override
  local -a name_parts
  require_repo

  mode="auto"
  sync="false"
  shell_output="false"
  delete_remote_override=""
  name=""
  name_parts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --local)
        mode="local"
        ;;
      --sync)
        sync="true"
        ;;
      --delete-remote)
        delete_remote_override="true"
        ;;
      --keep-remote)
        delete_remote_override="false"
        ;;
      --shell-output)
        shell_output="true"
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      *)
        name_parts+=("$1")
        ;;
    esac
    shift
  done

  base="$(base_branch)"
  delete_remote="$(delete_remote_on_finish)"
  validate_delete_remote_on_finish "${delete_remote}"
  if [[ -n "${delete_remote_override}" ]]; then
    delete_remote="${delete_remote_override}"
  fi
  base_path="$(base_worktree_path || true)"
  [[ -n "${base_path}" ]] || base_path="$(repo_root)"

  if [[ ${#name_parts[@]} -gt 0 ]]; then
    name="${name_parts[*]}"
  fi

  if [[ -z "${name}" ]]; then
    branch="$(current_branch)"
    if [[ "${branch}" != "$(branch_prefix)"* ]]; then
      die "finish needs a vibe name unless you run it from a feature worktree"
    fi
    slug="$(slug_from_branch "${branch}")"
  else
    branch="$(resolve_vibe_branch "${name_parts[@]}")"
    slug="$(slug_from_branch "${branch}")"
  fi

  branch_exists "${branch}" || die "branch ${branch} does not exist locally"
  path="$(find_worktree_for_branch "${branch}" || true)"
  [[ -n "${path}" ]] || path="$(worktree_path_for_slug "${slug}")"

  if [[ "${sync}" == "true" ]]; then
    run_fetch
  fi

  if [[ -d "${path}" ]]; then
    ensure_clean_tree "${path}"
  fi

  merged_into=""

  if is_ancestor_of "${branch}" "${base}"; then
    merged_into="${base}"
  elif remote_branch_exists "origin/${base}" && is_ancestor_of "${branch}" "origin/${base}"; then
    sync_base_branch
    base_path="$(base_worktree_path || true)"
    [[ -n "${base_path}" ]] || base_path="$(repo_root)"
    merged_into="origin/${base}"
  elif [[ "${mode}" == "local" ]]; then
    base_path="$(base_worktree_path || true)"
    [[ -n "${base_path}" ]] || die "could not find a worktree for ${base}"
    ensure_clean_tree "${base_path}"
    git -C "${base_path}" switch "${base}" >/dev/null 2>&1 || true
    git -C "${base_path}" merge --ff-only "${branch}"
    merged_into="${base}"
  fi

  [[ -n "${merged_into}" ]] || die "branch ${branch} is not merged into ${base}; merge it first or use --local"

  [[ -n "${base_path}" ]] || die "could not find a stable worktree for ${base}"

  if [[ "${delete_remote}" == "true" ]]; then
    (
      cd "${base_path}" >/dev/null 2>&1 || die "could not enter ${base_path}"
      delete_remote_branch "${branch}"
    )
  fi

  (
    cd "${base_path}" >/dev/null 2>&1 || die "could not enter ${base_path}"

    if [[ -d "${path}" ]]; then
      git worktree remove "${path}"
    fi

    git branch -d "${branch}" >/dev/null
    clear_session_metadata "${branch}"
    git worktree prune >/dev/null 2>&1 || true
  )

  say "Finished ${branch}"
  say "Merged into: ${merged_into}"
  if [[ "${delete_remote}" == "false" ]]; then
    say "Remote branch: kept"
  fi

  if [[ "${shell_output}" == "true" ]]; then
    say_shell_chdir "${base_path}"
  fi
}

command_release() {
  local raw_version version tag base version_file version_path push_after_release version_file_status
  require_repo

  raw_version=""
  push_after_release="false"
  version_file_status="none"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --push)
        push_after_release="true"
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      --*)
        die "unknown flag for release: $1"
        ;;
      *)
        [[ -z "${raw_version}" ]] || die "release accepts exactly one version"
        raw_version="$1"
        ;;
    esac
    shift
  done

  [[ -n "${raw_version}" ]] || die "release requires a version"

  base="$(base_branch)"
  [[ "$(current_branch)" == "${base}" ]] || die "release must be run from ${base}"

  ensure_clean_tree "$(repo_root)"

  version="$(normalize_release_version "${raw_version}")"
  tag="v${version}"
  version_file="$(release_version_file)"
  tag_exists "${tag}" && die "tag ${tag} already exists"

  if [[ -n "${version_file}" ]]; then
    version_path="$(repo_root)/${version_file}"
    [[ -f "${version_path}" ]] || die "release version file not found: ${version_file}"

    if [[ "$(<"${version_path}")" == "${version}" ]]; then
      version_file_status="unchanged"
    else
      printf '%s\n' "${version}" > "${version_path}"
      git add "${version_file}"
      version_file_status="updated"
    fi
  fi

  VIBE_ALLOW_COMMIT_BASE=1 git commit --allow-empty -m "chore(release): ${tag}" >/dev/null
  git tag -a "${tag}" -m "${tag}"

  if [[ "${push_after_release}" == "true" ]]; then
    push_base_branch_and_tags "${base}"
  fi

  say "Released ${tag}"
  case "${version_file_status}" in
    updated)
      say "Updated version file: ${version_file}"
      ;;
    unchanged)
      say "Version file already matched: ${version_file}"
      ;;
    *)
      say "Version file: skipped"
      ;;
  esac

  if [[ "${push_after_release}" == "true" ]]; then
    say "Pushed: origin/${base} and ${tag}"
  else
    say ""
    say "Next:"
    say "  git vibe release ${version} --push"
    say "  or: git push origin ${base} --tags"
  fi
}

doctor_findings_raw() {
  local branch path head detached bare locked locked_reason prunable prunable_reason detail

  while IFS=$'\t' read -r branch path head detached bare locked locked_reason prunable prunable_reason; do
    if [[ "${prunable}" == "true" ]]; then
      detail="stale worktree metadata"
      if [[ -n "${prunable_reason}" ]]; then
        detail="${detail}: ${prunable_reason}"
      fi
      printf '%s\t%s\t%s\t%s\n' "${branch}" "prunable" "${detail}" "${path}"
    elif ! worktree_path_exists "${path}"; then
      printf '%s\t%s\t%s\t%s\n' "${branch}" "missing" "worktree path is missing" "${path}"
    elif ! accessible_worktree_path "${path}"; then
      printf '%s\t%s\t%s\t%s\n' "${branch}" "broken" "worktree checkout is not accessible" "${path}"
    fi
  done < <(list_vibes_raw)
}

repair_worktree_metadata() {
  local branch path head detached bare locked locked_reason prunable prunable_reason

  git worktree repair "$(repo_root)" >/dev/null 2>&1 || true

  while IFS=$'\t' read -r branch path head detached bare locked locked_reason prunable prunable_reason; do
    if accessible_worktree_path "${path}"; then
      git worktree repair "${path}" >/dev/null 2>&1 || true
    fi
  done < <(list_vibes_raw)

  git worktree prune >/dev/null 2>&1 || true
}

command_list() {
  local base branch path head detached bare locked locked_reason prunable prunable_reason
  local state ahead session changes found
  require_repo
  base="$(base_branch)"
  found="false"

  while IFS=$'\t' read -r branch path head detached bare locked locked_reason prunable prunable_reason; do
    if [[ "${found}" == "false" ]]; then
      printf '%-32s %-18s %-10s %-32s %-32s %s\n' "BRANCH" "STATE" "AHEAD" "SESSION" "CHANGES" "PATH"
      found="true"
    fi

    state="$(worktree_state_label "${path}" "${locked}" "${prunable}")"
    ahead="$(vibe_ahead_behind_summary "${base}" "${branch}")"
    session="$(session_summary_for_branch "${branch}")"
    changes="$(worktree_change_summary "${base}" "${branch}" "${path}")"
    printf '%-32s %-18s %-10s %-32s %-32s %s\n' "${branch}" "${state}" "${ahead}" "${session}" "${changes}" "${path}"
  done < <(list_vibes_raw)

  if [[ "${found}" == "false" ]]; then
    say "No active vibes"
  fi
}

command_status() {
  local base current prefix root editor_mode workspace_app issue_style delete_remote_finish branch path
  local -a name_parts
  require_repo

  name_parts=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        print_help
        exit 0
        ;;
      *)
        name_parts+=("$1")
        ;;
    esac
    shift
  done

  base="$(base_branch)"
  current="$(current_branch)"
  prefix="$(branch_prefix)"
  root="$(vibe_root)"
  editor_mode="$(open_editor_mode)"
  workspace_app="$(workspace_app_setting)"
  issue_style="$(issue_branch_style)"
  delete_remote_finish="$(delete_remote_on_finish)"
  validate_open_editor_mode "${editor_mode}"
  validate_workspace_app "${workspace_app}"
  validate_issue_branch_style "${issue_style}"
  validate_delete_remote_on_finish "${delete_remote_finish}"

  say "Repo: $(repo_root)"
  say "Base branch: ${base}"
  say "Current branch: ${current}"
  say "Branch prefix: ${prefix}"
  say "Vibe root: ${root}"
  say "Open editor: ${editor_mode}"
  say "Open workspace with: ${workspace_app}"
  say "Issue branch style: ${issue_style}"
  say "Delete remote on finish: ${delete_remote_finish}"
  say ""

  if [[ ${#name_parts[@]} -gt 0 ]]; then
    branch="$(resolve_vibe_branch "${name_parts[@]}")"
    touch_session_metadata "${branch}"
    path="$(worktree_path_for_branch "${branch}")"
    print_vibe_context "${branch}" "${path}"
    print_pr_context "${branch}"
    return 0
  fi

  if is_vibe_branch "${current}"; then
    touch_session_metadata "${current}"
    print_vibe_context "${current}" "$(repo_root)"
    print_pr_context "${current}"
    say ""
  fi

  command_list
}

command_check() {
  command_status "$@"
}

command_path() {
  local slug branch path
  require_repo

  [[ $# -gt 0 ]] || die "path requires a vibe name"

  branch=""
  if is_issue_number_ref "$@"; then
    branch="$(find_issue_branch "$1" || true)"
  fi

  if [[ -z "${branch}" ]]; then
    slug="$(slug_from_name "$*")"
    branch="$(branch_from_slug "${slug}")"
  else
    slug="$(slug_from_branch "${branch}")"
  fi

  path="$(find_worktree_for_branch "${branch}" || true)"
  printf '%s\n' "${path:-$(worktree_path_for_slug "${slug}")}"
}

command_prune() {
  require_repo
  git worktree prune
  say "Pruned stale worktree metadata"
}

command_doctor() {
  local repair findings branch state detail path
  require_repo

  repair="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repair)
        repair="true"
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      *)
        die "doctor does not take a vibe name"
        ;;
    esac
    shift
  done

  if [[ "${repair}" == "true" ]]; then
    say "Doctor: repairing worktree metadata"
    repair_worktree_metadata
    say ""
  fi

  findings="$(doctor_findings_raw)"

  if [[ -z "${findings}" ]]; then
    if [[ "${repair}" == "true" ]]; then
      say "Doctor: no remaining worktree problems"
    else
      say "Doctor: no worktree problems found"
    fi
    return 0
  fi

  say "Doctor findings:"
  printf '%-32s %-10s %-40s %s\n' "BRANCH" "STATE" "DETAIL" "PATH"
  while IFS=$'\t' read -r branch state detail path; do
    printf '%-32s %-10s %-40s %s\n' "${branch}" "${state}" "${detail}" "${path}"
  done <<< "${findings}"

  if [[ "${repair}" != "true" ]]; then
    say ""
    say "Next:"
    say "  git vibe doctor --repair"
    say "  git vibe prune"
  fi
}

command_ship() {
  command_release "$@"
}

check_semantic_commit() {
  local message_file subject
  message_file="$1"
  subject="$(grep -v '^[[:space:]]*#' "${message_file}" | head -n 1 || true)"
  [[ -n "${subject}" ]] || exit 0

  if [[ "${subject}" =~ ^(Merge|Revert|fixup!|squash!|Initial\ commit) ]]; then
    exit 0
  fi

  if [[ "${subject}" =~ ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|release)(\([a-z0-9._/-]+\))?(!)?:\ .+ ]]; then
    exit 0
  fi

  cat >&2 <<EOF
git-vibe: commit messages must use semantic commits.
Example: feat(cli): add finish --sync
EOF
  exit 1
}

hook_pre_commit() {
  local base current allow
  require_repo

  base="$(base_branch)"
  current="$(current_branch)"
  allow="$(git config --bool --get vibe.allowCommitOnBase 2>/dev/null || true)"

  if [[ "${current}" == "${base}" && "${VIBE_ALLOW_COMMIT_BASE:-0}" != "1" && "${allow}" != "true" ]]; then
    die "commits on ${base} are blocked; open a vibe with: git vibe code <name>"
  fi
}

hook_commit_msg() {
  [[ $# -gt 0 ]] || die "commit-msg hook requires the commit message file"
  check_semantic_commit "$1"
}

hook_pre_push() {
  local base current blocked
  require_repo

  base="$(base_branch)"
  current="$(current_branch)"
  blocked="$(push_blocked_on_base)"

  if [[ "${current}" == "${base}" && "${VIBE_ALLOW_PUSH_BASE:-0}" != "1" && "${blocked}" == "true" ]]; then
    die "pushes from ${base} are blocked; merge via PR or override with VIBE_ALLOW_PUSH_BASE=1"
  fi
}

command_hook() {
  [[ $# -gt 0 ]] || die "hook requires a hook name"

  case "$1" in
    pre-commit)
      shift
      hook_pre_commit "$@"
      ;;
    commit-msg)
      shift
      hook_commit_msg "$@"
      ;;
    pre-push)
      shift
      hook_pre_push "$@"
      ;;
    *)
      die "unsupported hook: $1"
      ;;
  esac
}

command_version() {
  printf '%s\n' "${VERSION}"
}

main() {
  local command
  command="${1:-help}"

  case "${command}" in
    help|-h|--help)
      print_help
      ;;
    code)
      shift
      command_code "$@"
      ;;
    issue)
      shift
      command_issue "$@"
      ;;
    session)
      shift
      command_session "$@"
      ;;
    pr)
      shift
      command_pr "$@"
      ;;
    submit)
      shift
      command_submit "$@"
      ;;
    checks)
      shift
      command_checks "$@"
      ;;
    enter)
      shift
      command_enter "$@"
      ;;
    open)
      shift
      command_open "$@"
      ;;
    diff)
      shift
      command_diff "$@"
      ;;
    start)
      shift
      command_start "$@"
      ;;
    finish)
      shift
      command_finish "$@"
      ;;
    release)
      shift
      command_release "$@"
      ;;
    ship)
      shift
      command_ship "$@"
      ;;
    list)
      shift
      command_list "$@"
      ;;
    status)
      shift
      command_status "$@"
      ;;
    check)
      shift
      command_check "$@"
      ;;
    path)
      shift
      command_path "$@"
      ;;
    doctor)
      shift
      command_doctor "$@"
      ;;
    prune)
      shift
      command_prune "$@"
      ;;
    hook)
      shift
      command_hook "$@"
      ;;
    version)
      shift
      command_version "$@"
      ;;
    *)
      die "unknown command: ${command}"
      ;;
  esac
}

main "$@"
